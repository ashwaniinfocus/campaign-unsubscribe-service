# ---- Server ----
PORT=8080
BRAND_NAME=PulseReach
# Optional: shown as a "Back to website" link on result pages (http/https only)
HOME_URL=
# Minutes a confirm token stays valid after the unsubscribe link is opened
TOKEN_TTL_MINUTES=30
# Hops of proxies in front of the app (ALB = 1) so rate limiting sees the real client IP
TRUST_PROXY_HOPS=1
# Set to false if the DB user cannot ALTER/CREATE; run migrations/001_unsubscribe.sql manually instead
AUTO_MIGRATE=true

# ---- Aurora / RDS PostgreSQL with IAM authentication ----
RDS_HOST=your-cluster.cluster-xxxx.ap-south-1.rds.amazonaws.com
RDS_PORT=5432
RDS_USER=unsubscribe_svc
RDS_DBNAME=postgres
AWS_REGION=ap-south-1

# ---- Local development only (used when RDS_HOST is not set) ----
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
# DATABASE_SSL=false
